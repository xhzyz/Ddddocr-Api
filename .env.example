# Host address exposed by Docker. Keep 127.0.0.1 when using Nginx/Caddy.
DDDDOCR_BIND_IP=127.0.0.1
DDDDOCR_PUBLIC_PORT=5555

# Each worker loads its own ONNX model. One worker is the safe default.
DDDDOCR_WORKERS=1

# Startup preloading. Endpoints can still load another mode on demand.
DDDDOCR_OCR=true
DDDDOCR_DET=false
DDDDOCR_OLD=false
DDDDOCR_BETA=false
DDDDOCR_USE_GPU=false
DDDDOCR_DEVICE_ID=0
DDDDOCR_SHOW_AD=false

# Optional protection for all recognition/management endpoints. Health and
# Swagger documentation remain public. Send it as X-API-Key or Bearer token.
DDDDOCR_API_KEY=

# Comma-separated browser origins. Empty disables CORS; use * only when needed.
DDDDOCR_CORS_ORIGINS=

DDDDOCR_MAX_IMAGE_BYTES=8388608
DDDDOCR_MAX_IMAGE_SIDE=4096
DDDDOCR_MAX_BATCH_SIZE=32
DDDDOCR_MAX_INSTANCES=8
DDDDOCR_INSTANCE_TTL_SECONDS=3600

# Optional custom model paths. ./custom_models is already mounted read-only
# at /models by docker-compose.yml.
DDDDOCR_IMPORT_ONNX_PATH=
DDDDOCR_CHARSETS_PATH=
